---
import BaseLayout from "../layouts/BaseLayout.astro";
import { privacyConfig } from "../config/privacy.config";

const { meta, lastUpdated, intro, sections } = privacyConfig;
---
<BaseLayout title={meta.title} description={meta.description}>
  <section class="pt-32 pb-12 container mx-auto px-4 md:px-6 max-w-4xl" data-animate>
    <h1 class="text-4xl md:text-5xl font-bold font-display text-white mb-6">{meta.title}</h1>
    <p class="text-gray-400 mb-12">Last Updated: {lastUpdated}</p>

    <div class="prose prose-invert prose-blue max-w-none">
      <p class="text-lg text-gray-300 leading-relaxed mb-12">{intro}</p>

      <div class="space-y-12">
        {sections.map(section => (
          <div id={section.id} class="scroll-mt-32">
            <h2 class="text-2xl font-bold text-white mb-4">{section.heading}</h2>
            <p class="text-gray-400 leading-relaxed mb-6">{section.content}</p>

            {section.subsections && (
              <div class="space-y-6 pl-6 border-l border-gray-800">
                {section.subsections.map(sub => (
                  <div>
                    <h3 class="text-xl font-semibold text-white mb-2">{sub.heading}</h3>
                    <p class="text-gray-400 leading-relaxed">{sub.content}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
