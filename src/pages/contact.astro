---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactConfig } from "../config/contact.config";
import HeroSection from "../components/HeroSection.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import Button from "../components/Button.astro";
import SectionTitle from "../components/SectionTitle.astro";

const { hero, details, socials, form, faq } = contactConfig;
---
<BaseLayout title={hero.heading} description={hero.subheading}>

  <HeroSection
    headline={hero.heading}
    subheading={hero.subheading}
    centered={true}
  />

  <section class="container mx-auto px-4 md:px-6 py-12 mb-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

      <!-- Contact Info -->
      <div data-animate>
        <h2 class="text-3xl font-bold font-display text-white mb-8">Contact Information</h2>

        <div class="space-y-8">
          <div class="flex items-start">
            <div class="w-12 h-12 bg-blue-900/30 text-blue-400 rounded-lg flex items-center justify-center mr-4 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Office Location</h4>
              <p class="text-gray-400">{details.address}</p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="w-12 h-12 bg-blue-900/30 text-blue-400 rounded-lg flex items-center justify-center mr-4 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Email Address</h4>
              <a href={`mailto:${details.email}`} class="text-blue-400 hover:underline">{details.email}</a>
            </div>
          </div>

          <div class="flex items-start">
            <div class="w-12 h-12 bg-blue-900/30 text-blue-400 rounded-lg flex items-center justify-center mr-4 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Phone Number</h4>
              <p class="text-gray-400">{details.phone}</p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="w-12 h-12 bg-blue-900/30 text-blue-400 rounded-lg flex items-center justify-center mr-4 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Operating Hours</h4>
              <p class="text-gray-400">{details.hours}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="bg-[#0F1729] p-8 rounded-xl border border-gray-800" data-animate>
        <form class="space-y-6" onsubmit="event.preventDefault(); alert('Form submitted!');">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-400 mb-2">First Name</label>
              <input type="text" class="w-full bg-[#0A0F1E] border border-gray-800 rounded-md px-4 py-3 text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" required>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-400 mb-2">Last Name</label>
              <input type="text" class="w-full bg-[#0A0F1E] border border-gray-800 rounded-md px-4 py-3 text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" required>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-400 mb-2">Work Email</label>
            <input type="email" class="w-full bg-[#0A0F1E] border border-gray-800 rounded-md px-4 py-3 text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" required>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-400 mb-2">Interested Service</label>
            <select class="w-full bg-[#0A0F1E] border border-gray-800 rounded-md px-4 py-3 text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
              {form.services.map(service => (
                <option value={service}>{service}</option>
              ))}
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-400 mb-2">Message</label>
            <textarea rows="4" class="w-full bg-[#0A0F1E] border border-gray-800 rounded-md px-4 py-3 text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" required></textarea>
          </div>

          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-6 rounded-md transition-colors duration-200">
            {form.submitLabel}
          </button>
        </form>
      </div>

    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 bg-[#0F1729] border-y border-gray-800" data-animate>
    <div class="container mx-auto px-4 md:px-6">
      <SectionTitle heading="Frequently Asked Questions" subheading="Quick answers to common questions about our services." />
      <div class="mt-12">
        <FAQAccordion items={faq} />
      </div>
    </div>
  </section>

</BaseLayout>
