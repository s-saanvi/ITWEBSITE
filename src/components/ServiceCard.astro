---
import type { Service } from "../types";

export interface Props extends Service {
  href: string;
}

const { icon, title, shortDescription, features, href } = Astro.props;
---
<a href={href} class="service-card block bg-[#0F1729] rounded-xl p-8 border border-gray-800/50 hover:border-blue-500/30">
  <div class="w-12 h-12 rounded-lg bg-blue-900/30 text-blue-400 flex items-center justify-center mb-6">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
    </svg>
  </div>
  <h3 class="text-xl font-bold text-white mb-3">{title}</h3>
  <p class="text-gray-400 mb-6">{shortDescription}</p>
  <ul class="space-y-2 mb-6">
    {features.map((feature) => (
      <li class="flex items-center text-sm text-gray-300">
        <svg class="w-4 h-4 text-cyan-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        {feature}
      </li>
    ))}
  </ul>
  <span class="text-blue-400 font-medium text-sm group-hover:text-blue-300 inline-flex items-center">
    Learn more
    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
  </span>
</a>
