---
import { withBase } from "../utils";
export interface Props {
  slug: string;
  title: string;
  excerpt: string;
  category: string;
  date: string;
  readTime: string;
  image: string;
  author: string;
}

const { slug, title, excerpt, category, date, readTime, image, author } = Astro.props;
---
<a href={withBase(`/blog/${slug}`)} class="block bg-[#0F1729] rounded-xl overflow-hidden border border-gray-800 hover:border-blue-500/50 transition-colors group" data-animate>
  <div class="h-48 w-full bg-gray-800 overflow-hidden relative">
    <div class="absolute inset-0 bg-gray-700 group-hover:scale-105 transition-transform duration-500"></div>
    <span class="absolute top-4 left-4 bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-full z-10">{category}</span>
  </div>
  <div class="p-6">
    <div class="flex items-center text-xs text-gray-500 mb-3 space-x-4">
      <span>{date}</span>
      <span>•</span>
      <span>{readTime}</span>
    </div>
    <h3 class="text-xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors">{title}</h3>
    <p class="text-gray-400 mb-4 text-sm line-clamp-2">{excerpt}</p>
    <div class="flex items-center mt-4 pt-4 border-t border-gray-800">
      <div class="w-8 h-8 rounded-full bg-gray-700 mr-3"></div>
      <span class="text-sm font-medium text-gray-300">{author}</span>
    </div>
  </div>
</a>
