---
import type { CTA } from "../types";
import Button from "./Button.astro";

export interface Props {
  heading: string;
  subheading: string;
  cta: CTA;
  secondaryCta?: CTA;
}

const { heading, subheading, cta, secondaryCta } = Astro.props;
---
<div class="w-full bg-gradient-to-r from-blue-900 to-[#0A0F1E] rounded-2xl p-8 md:p-16 text-center border border-blue-800/50 relative overflow-hidden" data-animate>
  <div class="absolute inset-0 bg-[url('/grid.svg')] opacity-20"></div>
  <div class="relative z-10">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{heading}</h2>
    <p class="text-gray-300 max-w-2xl mx-auto mb-8 text-lg">{subheading}</p>
    <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
      <Button label={cta.label} href={cta.href} variant="primary" />
      {secondaryCta && <Button label={secondaryCta.label} href={secondaryCta.href} variant="ghost" />}
    </div>
  </div>
</div>
