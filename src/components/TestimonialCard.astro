---
import type { Testimonial } from "../types";

export interface Props extends Testimonial {}

const { name, role, company, avatar, rating, quote, category } = Astro.props;

const STARS = [0, 1, 2, 3, 4];
---
<div class="bg-[#0F1729] rounded-xl p-8 border border-gray-800">
  <div class="flex text-yellow-400 mb-4">
    {STARS.map((_, i) => (
      <svg class={`w-5 h-5 ${i < rating ? 'text-yellow-400' : 'text-gray-600'}`} fill="currentColor" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}
  </div>
  <p class="text-gray-300 italic mb-6">"{quote}"</p>
  <div class="flex items-center">
    <div class="w-12 h-12 rounded-full bg-gray-700 mr-4 overflow-hidden">
      <!-- Fallback empty div for avatar, normally an img tag would go here -->
    </div>
    <div>
      <h4 class="text-white font-medium">{name}</h4>
      <p class="text-sm text-gray-400">{role}, {company}</p>
    </div>
  </div>
</div>
