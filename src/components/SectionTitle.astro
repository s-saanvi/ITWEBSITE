---
export interface Props {
  heading: string;
  subheading?: string;
  sectionLabel?: string;
}

const { heading, subheading, sectionLabel } = Astro.props;
---
<div class="mb-12 text-center">
  {sectionLabel && <span class="text-cyan-400 font-semibold tracking-wider uppercase text-sm mb-2 block">{sectionLabel}</span>}
  <h2 class="text-3xl md:text-4xl font-bold font-display text-white mb-4">{heading}</h2>
  {subheading && <p class="text-gray-400 max-w-2xl mx-auto text-lg">{subheading}</p>}
</div>
