---
import { withBase } from "../utils";

export interface Props {
  name: string;
  role: string;
  image: string;
  linkedin: string;
}

const { name, role, image, linkedin } = Astro.props;
---
<div class="bg-[#0F1729] rounded-xl overflow-hidden border border-gray-800 group" data-animate>
  <div class="aspect-w-1 aspect-h-1 w-full overflow-hidden bg-gray-800">
    <img
      src={withBase(image)}
      alt={name}
      class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
    />
  </div>
  <div class="p-6">
    <h3 class="text-xl font-bold text-white mb-1">{name}</h3>
    <p class="text-blue-400 mb-4">{role}</p>
    <a href={linkedin} class="text-gray-500 hover:text-white transition-colors">
      <span class="sr-only">LinkedIn</span>
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>
</div>
