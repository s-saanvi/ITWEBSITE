---
export interface Props {
  year: string;
  title: string;
  description: string;
  isLast?: boolean;
}

const { year, title, description, isLast = false } = Astro.props;
---
<div class="relative pl-8 md:pl-0" data-animate>
  <div class="md:flex items-center justify-between w-full">
    <div class="order-1 w-5/12 hidden md:block"></div>

    <!-- Dot and Line -->
    <div class="z-20 flex items-center order-1 bg-blue-900 shadow-xl w-8 h-8 rounded-full absolute left-0 md:left-1/2 -translate-x-1/2 border-4 border-[#0A0F1E]">
      <div class="w-2 h-2 mx-auto bg-cyan-400 rounded-full"></div>
    </div>
    {!isLast && <div class="absolute left-[15px] md:left-1/2 top-8 bottom-[-2rem] w-px bg-gray-800 -translate-x-1/2"></div>}

    <div class="order-1 bg-[#0F1729] rounded-lg shadow-xl md:w-5/12 px-6 py-4 border border-gray-800 mb-8 md:mb-0 w-full ml-4 md:ml-0 relative">
      <!-- Arrow -->
      <div class="absolute top-4 -left-3 w-0 h-0 border-t-[10px] border-t-transparent border-b-[10px] border-b-transparent border-r-[12px] border-r-[#0F1729] hidden md:block md:right-auto md:border-r-[#0F1729]"></div>

      <span class="inline-block px-3 py-1 mb-3 text-xs font-semibold tracking-wider text-blue-900 uppercase bg-blue-100 rounded-full">{year}</span>
      <h3 class="mb-3 font-bold text-white text-xl">{title}</h3>
      <p class="text-sm leading-snug tracking-wide text-gray-400 text-opacity-100">{description}</p>
    </div>
  </div>
</div>
